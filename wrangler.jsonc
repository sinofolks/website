{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redraw-website",
  "account_id": "3646841b3438ff18bbd3ec454e83dc01",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/redraw/downloads",
      "/redraw/downloads/*",
      "/redraw/updates",
      "/redraw/updates/*",
      "/redraw/sign-in",
      "/redraw/sign-in/*",
      "/redraw/account",
      "/redraw/account/*",
      "/redraw/auth",
      "/redraw/auth/*",
      "/redraw/api",
      "/redraw/api/*",
      "/redraw/webhooks",
      "/redraw/webhooks/*",
      "/.well-known/oauth-authorization-server/redraw/auth"
    ]
  },
  "routes": [
    {
      "pattern": "www.sinofolks.com/redraw/*",
      "zone_name": "sinofolks.com"
    },
    {
      "pattern": "www.sinofolks.com/.well-known/oauth-authorization-server/redraw/auth",
      "zone_name": "sinofolks.com"
    }
  ],
  "main": "src/worker.mjs",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    },
    "redact_query_string": true
  },
  "services": [
    {
      "binding": "REDRAW_API",
      "service": "redraw-api"
    }
  ]
}
